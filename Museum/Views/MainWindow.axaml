<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Museum.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Museum.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Museum"
        WindowState="FullScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Border IsVisible="{Binding !IsLangChoiceActive}"
                DockPanel.Dock="Top"
                Height="40"
                Background="#Ca005d">

            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                  Margin="20,0">

                <Button Name="GoToMapButton" Grid.Column="0" Content="Plan" Foreground="White" Background= "#Ca005d"/>
                <Button Name="GoToAgendaButton" Grid.Column="1" Content="Événements" Foreground="White" Background= "#Ca005d"/>
                <Button  Grid.Column="2" Content="Newsletter" Foreground="White" Background= "#Ca005d"/>
                <Button  Grid.Column="3" Content="Satisfaction" Foreground="White" Background= "#Ca005d"/>
                <!-- Pas de colonne 4 pour espacer -->
                <Button Name="GoToConnectionButton" Grid.Column="5" Content="Se connecter" Foreground="White" Background= "#Ca005d"/>
            </Grid>
        </Border>

        <ContentControl Name="ContentControl"/>
    </DockPanel>

</Window>
