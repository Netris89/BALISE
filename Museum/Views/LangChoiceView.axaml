<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Museum.Views.LangChoiceView">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
        <TextBlock HorizontalAlignment="Center">Choisissez votre langue</TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="50">
            <StackPanel>
                <Rectangle Fill="#FF00B3" Width="63" Height="41" Canvas.Left="40" Canvas.Top="31"></Rectangle>
                <TextBlock Text="Langue 1"></TextBlock>
            </StackPanel>
            <StackPanel>
                <Rectangle Fill="Blue" Width="63" Height="41" Canvas.Left="40" Canvas.Top="31"></Rectangle>
                <TextBlock Text="Langue 2"></TextBlock>
            </StackPanel>
            <StackPanel>
                <Rectangle Fill="#00FF4C" Width="63" Height="41" Canvas.Left="40" Canvas.Top="31"></Rectangle>
                <TextBlock Text="Langue 3"></TextBlock>
            </StackPanel>
            <StackPanel>
                <Rectangle Fill="#00EEFF" Width="63" Height="41" Canvas.Left="40" Canvas.Top="31"></Rectangle>
                <TextBlock Text="Langue 4"></TextBlock>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
