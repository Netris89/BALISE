<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.PointOfInterestEditorView"
             x:DataType="vm:PointOfInterestEditorViewModel">
    <StackPanel Spacing="20">
        <TextBlock Margin="10" Text="{Binding Name}" FontSize="22" FontWeight="Bold"/>

        <Separator Background="#EEEEEE" Height="1"/>

        <StackPanel Classes="fieldGroup">
            <TextBlock Classes="sectionLabel" Text="Nom"/>
            <TextBox Text="{Binding Name}" Padding="12,10"/>
        </StackPanel>

        <StackPanel Classes="fieldGroup">
            <TextBlock Classes="sectionLabel" Text="Nom allemand"/>
            <TextBox Text="{Binding NameDe}" Padding="12,10"/>
        </StackPanel>

        <StackPanel Classes="fieldGroup">
            <TextBlock Classes="sectionLabel" Text="Nom anglais"/>
            <TextBox Text="{Binding NameEn}" Padding="12,10"/>
        </StackPanel>

        <StackPanel Classes="fieldGroup">
            <TextBlock Classes="sectionLabel" Text="Nom néerlandais"/>
            <TextBox Text="{Binding NameNl}" Padding="12,10"/>
        </StackPanel>

        <StackPanel Classes="fieldGroup">
            <TextBlock Classes="sectionLabel" Text="Descripton"/>
            <TextBox Text="{Binding Description}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     Padding="12,10"/>
        </StackPanel>

        <StackPanel Classes="fieldGroup">
            <TextBlock Classes="sectionLabel" Text="Descripton allemande"/>
            <TextBox Text="{Binding DescriptionDe}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     Padding="12,10"/>
        </StackPanel>

        <StackPanel Classes="fieldGroup">
            <TextBlock Classes="sectionLabel" Text="Descripton anglaise"/>
            <TextBox Text="{Binding DescriptionEn}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     Padding="12,10"/>
        </StackPanel>

        <StackPanel Classes="fieldGroup">
            <TextBlock Classes="sectionLabel" Text="Descripton néerlandaise"/>
            <TextBox Text="{Binding DescriptionNl}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     Padding="12,10"/>
        </StackPanel>

        <Button Margin="10" HorizontalAlignment="Right"
                Foreground="White"
                Background="#Ca005d"
                Padding="30 10 30 10"
                CornerRadius="8"
                Command="{Binding SaveCommand}"
                Content="Sauver"/>
    </StackPanel>
</UserControl>
