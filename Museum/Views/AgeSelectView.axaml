<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="using:Balise.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             x:DataType="vm:AgeSelectViewModel"
             x:Class="Balise.Views.AgeSelectView">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="20" Text="{x:Static localization:Resources.Visit}"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="20">
            <Button Classes="primaryButton" Width="180" Height="90" Command="{Binding SelectAgeCommand}" CommandParameter="Adult">
                <TextBlock FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static localization:Resources.Adult}" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
            <Button Classes="primaryButton" Width="180" Height="90" Command="{Binding SelectAgeCommand}" CommandParameter="Child">
                <TextBlock FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static localization:Resources.Child}" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
            <Button Classes="primaryButton" Width="180" Height="90" Command="{Binding SelectAgeCommand}" CommandParameter="Disabled">
                <TextBlock FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static localization:Resources.Disability}" TextWrapping="Wrap" TextAlignment="Center"/>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
