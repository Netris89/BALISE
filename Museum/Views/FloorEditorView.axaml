<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.FloorEditorView">
    <StackPanel Spacing="20">
        <TextBlock Margin="10"  FontSize="22" FontWeight="Bold"/>

        <Separator Background="#EEEEEE" Height="1"/>

        <StackPanel Spacing="6" Margin="10">
            <TextBlock Classes="sectionLabel" Text="Nom"/>
            <TextBox  Padding="12,10"/>
        </StackPanel>

        <Button Classes="primaryButton"                
                Content="Sauver"/>
    </StackPanel>
</UserControl>
