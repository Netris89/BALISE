<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="using:Balise.Models"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.ContentManagerView"
             x:DataType="vm:ContentManagerViewModel">
    <Grid ColumnDefinitions="*, *">
        <StackPanel Grid.Column="0">
            <ComboBox ItemsSource="{Binding Museums}" SelectedItem="{Binding SelectedMuseum}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TreeView ItemsSource="{Binding SelectedMuseum.Floors}" SelectedItem="{Binding SelectedItem}" Grid.Column="0">
                <TreeView.DataTemplates>
                    <TreeDataTemplate DataType="model:Floor" ItemsSource="{Binding Spaces}" >
                        <TextBlock Text="{Binding Number}"/>
                    </TreeDataTemplate>

                    <TreeDataTemplate DataType="model:Space" ItemsSource="{Binding PointOfInterests}">
                        <TextBlock Text="{Binding Name}"/>
                    </TreeDataTemplate>

                    <TreeDataTemplate DataType="model:PointOfInterest">
                        <TextBlock Text="{Binding Name}"/>
                    </TreeDataTemplate>
                </TreeView.DataTemplates>
            </TreeView>
        </StackPanel>
        <Button Click="OpenFileButton_Clicked" Content="Importer un fichier"/>
        <ContentControl Grid.Column="1" Content="{Binding SelectedEditor}"/>
    </Grid>
</UserControl>
