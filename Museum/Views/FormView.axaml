<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             xmlns:localization="clr-namespace:Balise.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.FormView"
             x:DataType="vm:FormViewModel">
    <Grid VerticalAlignment="Center" ColumnDefinitions="4*,*,3*,*,3*,*,4*" RowDefinitions="*,*,*,*,*,*,*" RowSpacing="20">
        <!-- Name -->
        <TextBlock Classes="formLabel" Grid.Row="0" Grid.Column="1" Text= "{x:Static localization:Resources.Name}"/>
        <StackPanel Grid.Row= "0" Grid.Column="2" >
            <TextBlock Classes="formError" Opacity="{Binding !LastNameError}" Text="{x:Static localization:Resources.LastNameError}" />
            <TextBox Text="{Binding LastName}" PlaceholderText= "{x:Static localization:Resources.NamePlaceholder}"/>
        </StackPanel>
        <!-- First name -->
        <TextBlock Classes="formLabel" Grid.Row="0" Grid.Column="3" Text= "{x:Static localization:Resources.FirstName}"/>
        <StackPanel Grid.Row= "0" Grid.Column="4">
            <TextBlock Classes="formError" Opacity="{Binding !FirstNameError}" Text="{x:Static localization:Resources.FirstNameError}" />
            <TextBox Text="{Binding FirstName}" PlaceholderText= "{x:Static localization:Resources.FirstNamePlaceholder}"/>
        </StackPanel>
        <!-- Address -->
        <TextBlock Classes="formLabel" Grid.Row="1" Grid.Column="1" Text="{x:Static localization:Resources.Address}"/>
        <StackPanel Grid.Row= "1" Grid.Column="2">
            <TextBlock Classes="formError" Opacity="{Binding !AddressError}" Text="{x:Static localization:Resources.AddressError}" />
            <TextBox Text="{Binding Address}" PlaceholderText= "{x:Static localization:Resources.AddressPlaceholder}"/>
        </StackPanel>
        <!-- Number -->
        <TextBlock Classes="formLabel" Grid.Row="1" Grid.Column="3" Text="{x:Static localization:Resources.Number}"/>
        <StackPanel Grid.Row= "1" Grid.Column="4">
            <TextBlock Classes="formError" Opacity="{Binding !NumberError}" Text="{x:Static localization:Resources.NumberError}" />
            <TextBox Text="{Binding Number}"  PlaceholderText= "{x:Static localization:Resources.NumberPlaceholder}"/>
        </StackPanel >
        <!-- City -->
        <TextBlock Classes="formLabel" Grid.Row="2" Grid.Column="1" Text="{x:Static localization:Resources.City}"/>
        <StackPanel Grid.Row= "2" Grid.Column="2">
            <TextBlock Classes="formError" Opacity="{Binding !CityError}" Text="{x:Static localization:Resources.CityError}" />
            <TextBox Text="{Binding City}" PlaceholderText= "{x:Static localization:Resources.CityPlaceholder}"/>
        </StackPanel>
        <!-- Country -->
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Grid.Row="2" Grid.Column="3" Text="{x:Static localization:Resources.Country}"/>
        <ComboBox Grid.Row="2"
                  Grid.Column="4"
                  ItemsSource="{Binding Countries}"
                  SelectedItem="{Binding SelectedCountry}"
                  PlaceholderText="{x:Static localization:Resources.CountryPlaceholder}"
                  HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <!-- Email -->
        <TextBlock Classes="formLabel" Grid.Row="3" Grid.Column="1" Text="{x:Static localization:Resources.Email}"/>
        <StackPanel Grid.Row="3" Grid.Column="2">
            <TextBlock Classes="formError" Opacity="{Binding !EmailError}" Text="{x:Static localization:Resources.EmailError}" />
            <TextBox Text="{Binding Email}" PlaceholderText="{x:Static localization:Resources.EmailPlaceholder}"  Name="EmailTextBox"/>
        </StackPanel>

        <!-- CheckBox Newletter -->
        <CheckBox IsChecked="{Binding IsNewletterChecked}" HorizontalAlignment="Right" Grid.Row="4" Grid.Column="1"/>
        <TextBlock VerticalAlignment="Center" Margin="5" Grid.Row="4" Grid.Column="2" Text="{x:Static localization:Resources.NewsletterPlaceholder}"/>

        <!-- CheckBox Survey -->
        <CheckBox IsChecked="{Binding IsSatisfactionChecked}" HorizontalAlignment="Right" Grid.Row="5" Grid.Column="1"/>
        <TextBlock VerticalAlignment="Center" Margin="5" Grid.Row="5" Grid.Column="2" Text="{x:Static localization:Resources.SatisfactionPlaceholder}"/>

        <!-- Bouton Accept -->
        <Button Grid.Row="6" Grid.Column="2" HorizontalAlignment="Right" Command="{Binding AcceptCommand}" IsEnabled="{Binding IsFormCompleted}">
            <TextBlock Text="{x:Static localization:Resources.AcceptText}"/>
        </Button>
        <!-- Bouton Cancel -->
        <Button Grid.Row="6" Grid.Column="4" HorizontalAlignment="Left" Command="{Binding CancelCommand}">
            <TextBlock Text="{x:Static localization:Resources.CancelText}" />
        </Button>
    </Grid>
</UserControl>
