<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
             xmlns:localization="clr-namespace:Balise.Localization"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             x:DataType="vm:MapViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.MapView">
    <Grid RowDefinitions="auto, *">

        <!-- Floor buttons -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal">
            <!-- Floor navigation bound to ChangeFloorCommand -->    
            <ItemsControl ItemsSource="{Binding Floors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Number}" Command="{Binding $parent[ItemsControl].DataContext.ChangeFloorCommand}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Map -->
        <Grid Grid.Row="1">
            <mapsui:MapControl x:Name="MapControl" Map="{Binding Map}"/>

            <!-- Floating panel -->
            <!-- Two independent selections:
                - SelectedSpace: main context displayed in side panel
                - SelectedPointOfInterest: secondary overlay popup -->
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding SelectedSpace, Converter={x:Static ObjectConverters.IsNotNull}}"
                    BorderThickness="2"
                    BorderBrush="#6E808080"
                    BoxShadow="1 1 5 0 Gray"
                    CornerRadius="5"
                    Margin="20 0 50 25"
                    Background="White"
                    Name="infoPanel">
                <!-- Side panel bound to currently selected space -->
                <StackPanel DataContext="{Binding SelectedSpace}" Width="350">
                    <!-- Title -->
                    <Border Padding="5" Margin="5">
                        <Grid ColumnDefinitions="*, auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="InformationOutline" Foreground="#Ca005d" FontSize="30" Padding="10"/>
                                <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="Black" Text="Informations" />
                            </StackPanel>
                            <Button Classes="plainButton" Grid.Column="1" FontSize="30" Content="{materialIcons:MaterialIconExt Kind=Close}" Foreground="#Ca005d" Command="{Binding $parent[UserControl].DataContext.ClosePanelCommand}"/>
                        </Grid>
                    </Border>
                    <!-- Name -->
                    <Border Classes="infoSection">
                        <Grid ColumnDefinitions="auto, *">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="Warehouse" Foreground="#Ca005d" FontSize="30" Padding="10"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="sectionLabel" Text="{x:Static localization:Resources.Name}" />
                                <TextBlock FontSize="14" Text="{Binding Name}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Description -->
                    <Border Classes="infoSection">
                        <Grid ColumnDefinitions="auto, *">
                            <materialIcons:MaterialIcon Grid.Column="0" Kind="NoteTextOutline" Foreground="#Ca005d" FontSize="30" Padding="10"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="sectionLabel" Text="{x:Static localization:Resources.DescriptionText}" />
                                <TextBlock FontSize="14" Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- List of points of interest -->
                    <Border Classes="infoSection">
                        <StackPanel>
                            <TextBlock Classes="sectionLabel" Text="{x:Static localization:Resources.PointOfInterests}"/>
                            <ItemsControl ItemsSource="{Binding PointOfInterests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="auto, *">
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="MapMarkerOutline" Foreground="#Ca005d" FontSize="30" Padding="10"/>
                                            <Panel Grid.Column="1">
                                                <!-- Access parent ViewModel because DataTemplate DataContext is a PointOfInterest -->
                                                <Button Content="{Binding Name}" Classes="plainButton" Command="{Binding $parent[UserControl].DataContext.SelectingPoiCommand}" CommandParameter="{Binding}"/>

                                                <!-- Popup bound to global SelectedPointOfInterest and anchored to info panel -->
                                                <Popup PlacementTarget="infoPanel" Placement="RightEdgeAlignedTop" IsOpen="{Binding $parent[UserControl].DataContext.SelectedPointOfInterest, Converter={x:Static ObjectConverters.IsNotNull}}" IsLightDismissEnabled="True">
                                                    <Border Classes="infoSection" Background="White">
                                                        <!-- Override DataContext to display details of the globally selected POI -->
                                                        <StackPanel DataContext="{Binding $parent[UserControl].DataContext.SelectedPointOfInterest}">
                                                            <Border Classes="infoSection">
                                                                <StackPanel>
                                                                    <TextBlock Classes="sectionLabel" Text="{x:Static localization:Resources.Name}" />
                                                                    <TextBlock FontSize="14" Text="{Binding Name}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Classes="infoSection">
                                                                <StackPanel>
                                                                    <TextBlock Classes="sectionLabel" Text="{x:Static localization:Resources.DescriptionText}" />
                                                                    <TextBlock FontSize="14" Text="{Binding Description}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Panel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Button Background="#Ca005d" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding ReinitializeCommand}" Margin="30">
                <materialIcons:MaterialIcon Grid.Column="0" Kind="CrosshairsGps" Foreground="White" FontSize="30" Padding="10"/>
            </Button>
        </Grid>

    </Grid>
</UserControl>
