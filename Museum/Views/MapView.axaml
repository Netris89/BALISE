<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:Balise.Localization"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             x:DataType="vm:MapViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.MapView">
    <Grid RowDefinitions="auto, *">

        <!-- Floor buttons -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Floors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Number}" Command="{Binding $parent[ItemsControl].DataContext.ChangeFloorCommand}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        
        <!-- Map -->
        <Grid Grid.Row="1">
            <Image Source="{Binding Image}" Stretch="Uniform"/>

            <ItemsControl ItemsSource="{Binding Spaces}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Polygon Points="{Binding AvaloniaPoints}" Fill="Red"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Floating panel -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsSpaceDetailsVisible}">
            <StackPanel>
                <TextBlock Text="{Binding SelectedSpace.Name}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
