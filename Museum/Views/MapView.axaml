<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:Balise.Localization"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             x:DataType="vm:MapViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.MapView">
    <Grid RowDefinitions="auto, auto">
        <!-- Floor buttons -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal">
            <Button Content="Rez de chaussée" CommandParameter="0" Command="{Binding ChangeFloor}"/>
            <Button Content="1er étage" CommandParameter="1" Command="{Binding ChangeFloor}"/>
            <Button Content="2ème étage" CommandParameter="2" Command="{Binding ChangeFloor}"/>
        </StackPanel>
        <!-- Map -->
        <Image Grid.Row="1" Source="{Binding Image}"/>
        <!-- Clickable zone -->
        <Canvas>
            <Polygon Points="0,0 100,0 100,100 0,100 0,0" Fill="Transparent" Stroke="Red" StrokeThickness="2" PointerPressed="PolygonPressed"/>
        </Canvas>
        <!-- Floating panel -->
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsSpaceDetailsVisible}">

            <StackPanel>
                <TextBlock Text="{Binding SelectedSpace.Name}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
