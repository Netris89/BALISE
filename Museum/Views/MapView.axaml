<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:Balise.Localization"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             x:DataType="vm:MapViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.MapView">
    <Grid RowDefinitions="auto, *">

        <!-- Floor buttons -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Floors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Number}" Command="{Binding $parent[ItemsControl].DataContext.ChangeFloorCommand}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Map -->
        <Grid Grid.Row="1">
            <Image Source="{Binding Image}" Stretch="Uniform"/>

            <ItemsControl ItemsSource="{Binding Spaces}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Polygon Points="{Binding AvaloniaPoints}" Fill="Red" PointerPressed="PolygonPressed"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Floating panel -->
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding SelectedSpace, Converter={x:Static ObjectConverters.IsNotNull}}"
                    BorderThickness="2"
                    BorderBrush="#6E808080"
                    BoxShadow="1 1 5 0 Gray"
                    CornerRadius="5"
                    Margin="20 0 50 25"
                    Background="White">
                <StackPanel DataContext="{Binding SelectedSpace}" Width="350">
                    <!-- Title -->
                    <Border Padding="5" Margin="5">
                        <Grid ColumnDefinitions="*, auto">
                            <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" Foreground="Black" Text="Informations" />
                        </Grid>
                    </Border>
                    <!-- Name -->
                    <Border Classes="infoSection">
                        <StackPanel>
                            <TextBlock Classes="sectionLabel" Text="{x:Static localization:Resources.Name}" />
                            <TextBlock FontSize="14" Text="{Binding Name}" />
                        </StackPanel>
                    </Border>
                    <!-- Description -->
                    <Border Classes="infoSection">
                        <StackPanel>
                            <TextBlock Classes="sectionLabel" Text="{x:Static localization:Resources.DescriptionText}" />
                            <TextBlock FontSize="14" Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <!-- List of points of interest -->
                    <Border Classes="infoSection">
                        <StackPanel>
                            <TextBlock Classes="sectionLabel" Text="{x:Static localization:Resources.PointOfInterests}"/>
                            <ItemsControl ItemsSource="{Binding PointOfInterests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="14" Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <!-- <Panel>
                <Button x:Name="ToggleButton" Content="Show Popup"
                        Click="OnTogglePopup" />

                <Popup Name="MyPopup"
                       PlacementTarget="{Binding #ToggleButton}"
                       Placement="Left"
                       IsLightDismissEnabled="True">
                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="12">
                        <TextBlock Text="This is popup content." />
                    </Border>
                </Popup>
            </Panel> -->
        </Grid>

    </Grid>
</UserControl>
