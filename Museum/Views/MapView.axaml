<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:Balise.Localization"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             x:DataType="vm:MapViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.MapView">
    <Grid RowDefinitions="auto, *">

        <!-- Floor buttons -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding Floors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Number}" Command="{Binding $parent[ItemsControl].DataContext.ChangeFloorCommand}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Map -->
        <Grid Grid.Row="1">
            <Image Source="{Binding Image}" Stretch="Uniform"/>

            <ItemsControl ItemsSource="{Binding Spaces}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Polygon Points="{Binding AvaloniaPoints}" Fill="Red" PointerPressed="PolygonPressed"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Floating panel -->
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    IsVisible="{Binding SelectedSpace, Converter={x:Static ObjectConverters.IsNotNull}}"
                    BorderThickness="2"
                    BorderBrush="Black"
                    BoxShadow="1 1 10 0 Black"
                    CornerRadius="0 10 10 0">
                <StackPanel DataContext="{Binding SelectedSpace}">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Description}" />
                    <ItemsControl ItemsSource="{Binding PointOfInterests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
