<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Balise.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Balise.Views.SpaceEditorView"
             x:DataType="vm:SpaceEditorViewModel">
    <StackPanel Spacing="20">
        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"/>

        <Separator Background="#EEEEEE" Height="1"/>

        <StackPanel Spacing="6">
            <TextBlock Classes="sectionLabel" Text="Nom"/>
            <TextBox Text="{Binding Name}" Padding="12,10"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="sectionLabel" Text="Descripton"/>
            <TextBox Text="{Binding Description}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="140"
                     Padding="12,10"/>
        </StackPanel>

        <Button HorizontalAlignment="Right"
                Foreground="White"
                Background="#Ca005d"
                Padding="30 10 30 10"
                CornerRadius="8"
                Command="{Binding SaveCommand}"
                Content="Sauver"/>
    </StackPanel>
</UserControl>
