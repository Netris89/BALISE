<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Balise"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Balise.App"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Reusable card style for information sections -->
        <Style Selector="Border.infoSection">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#6E808080" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="10 5 10 5" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!-- Reusable label style for section headers -->
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="Gray" />
        </Style>

        <!-- Standard style for form field labels (aligned right, bottom spacing) -->
        <Style Selector="TextBlock.formLabel">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Standard style for validation error messages -->
        <Style Selector="TextBlock.formError">
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <!-- Icon-only button with no background or border (e.g. close button) -->
        <Style Selector="Button.plainButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Title of an editor view (Name displayed large at the top) -->
        <Style Selector="TextBlock.editorTitle">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="10" />
        </Style>

        <!-- Divider under the title of an editor view -->
        <Style Selector="Separator.editorDivider">
            <Setter Property="Background" Value="#EEEEEE" />
            <Setter Property="Height" Value="1" />
        </Style>

        <!-- Label + field group in an editor form -->
        <Style Selector="StackPanel.fieldGroup">
            <Setter Property="Spacing" Value="6" />
            <Setter Property="Margin" Value="10, 0" />
        </Style>

        <!-- Standard padding for text fields in editor views -->
        <Style Selector="TextBox.editorInput">
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <!-- Primary action button (pink) -->
        <Style Selector="Button.primaryButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#Ca005d" />
            <Setter Property="Padding" Value="30 10 30 10" />
        </Style>

    </Application.Styles>
</Application>