<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
        <PackageReference Include="Avalonia" Version="12.0.5" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
        <!--Condition
        below is needed to remove Avalonia.Diagnostics package from build output in Release
        configuration.-->
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
        <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.0" />
        <PackageReference Include="HtmlAgilityPack" Version="1.13.0-beta1" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
        <PackageReference Include="NetTopologySuite" Version="2.6.0" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.2" />
        <PackageReference Include="Npgsql.NetTopologySuite" Version="10.0.3" />
        <PackageReference Include="ReactiveUI" Version="23.2.28" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.3" />
    </ItemGroup>
    <PropertyGroup>
        <RootNamespace>Balise</RootNamespace>
        <AssemblyName>Balise</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Update="Localization\Resources.resx">
            <Generator>MSBuild:Compile</Generator>
            <StronglyTypedFileName>Localization\Resources.Designer.cs</StronglyTypedFileName>
            <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
            <StronglyTypedNamespace>Balise.Localization</StronglyTypedNamespace>
            <StronglyTypedClassName>Resources</StronglyTypedClassName>
            <PublicClass>true</PublicClass>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>
    <!-- Désactive l'avertissement CS2002 car Resources.Designer.cs est inclus deux fois :
    une première fois par le générateur MSBuild lié au .resx, et une seconde fois
    par l'inclusion automatique des fichiers .cs du SDK.
    Cette duplication est volontaire afin de conserver la compatibilité avec VSCode
    et l'outillage XAML (Avalonia), tout en évitant les avertissements de compilation. -->
    <PropertyGroup>
        <NoWarn>$(NoWarn);CS2002</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Update="Views\AdminView.axaml.cs">
            <DependentUpon>AdminView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\AgendaView.axaml.cs">
            <DependentUpon>AgendaView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\ConnectionView.axaml.cs">
            <DependentUpon>ConnectionView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\ContentManagerView.axaml.cs">
            <DependentUpon>ContentManagerView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\FormView.axaml.cs">
            <DependentUpon>FormView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\LangChoiceView.axaml.cs">
            <DependentUpon>LangChoiceView.axaml</DependentUpon>
        </Compile>
        <Compile Update="Views\MapView.axaml.cs">
            <DependentUpon>MapView.axaml</DependentUpon>
        </Compile>
    </ItemGroup>
</Project>